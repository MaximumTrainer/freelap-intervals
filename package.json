{
  "name": "freelap-intervals",
  "version": "0.1.0",
  "private": true,
  "description": "Sync Freelap sprint sessions into intervals.icu activities",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run test",
    "migrate": "tsx src/db/migrate-cli.ts",
    "web": "tsx src/web/main.ts",
    "worker": "tsx src/worker/main.ts",
    "sync": "tsx src/cli/main.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/pg": "^8.23.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "pg": "^8.23.0"
  }
}
