# --- storage -------------------------------------------------------------
DATABASE_URL=postgres://localhost:5432/freelap

# --- secrets -------------------------------------------------------------
# Master keys for the credential store, newest last: <key-id>:<base64 32 bytes>.
# Generate one with: node -e "console.log('key-1:' + require('crypto').randomBytes(32).toString('base64'))"
FREELAP_MASTER_KEYS=key-1:REPLACE_ME
FREELAP_CURRENT_KEY_ID=key-1
SESSION_COOKIE_SECRET=REPLACE_ME
CSRF_SECRET=REPLACE_ME
# At least 128 bits of entropy — the path segment that authenticates webhook calls.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
WEBHOOK_SECRET=REPLACE_ME
# Token protecting the /metrics endpoint from public access.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
METRICS_SECRET=REPLACE_ME

# --- intervals.icu OAuth app (register by emailing intervals.icu) ---------
INTERVALS_ICU_CLIENT_ID=
INTERVALS_ICU_CLIENT_SECRET=
INTERVALS_ICU_REDIRECT_URI=http://localhost:3000/oauth/callback

# --- optional ------------------------------------------------------------
PORT=3000
# Maximum request body size in bytes (default 5 MB). Webhook and sign-in routes use lower caps.
# MAX_REQUEST_BODY_BYTES=5242880
FREELAP_TIMEZONE=Europe/London
# The MyFreelap web adapter is unofficial; it stays off unless switched on here.
FREELAP_WEB_ADAPTER=off
# Dedicated test account for the nightly MyFreelap canary. Required when the adapter is on.
# FREELAP_CANARY_USERNAME=canary@test.example.com
# FREELAP_CANARY_PASSWORD=canary-pass
# Outbound rate limits as <req/s>,<burst>. Defaults: intervals.icu 5,10; MyFreelap 0.5,3.
# ICU_RATE_LIMIT=5,10
# MYFREELAP_RATE_LIMIT=0.5,3
# Alert webhook URL. When set, critical/warning/recovery alerts are POSTed as JSON to this URL.
# Works with Slack incoming webhooks, PagerDuty, Zapier, or any HTTP endpoint.
# When unset, alerts are written to the structured log instead.
# ALERT_WEBHOOK_URL=https://hooks.slack.com/services/T.../B.../...

# --- the API-key CLI (npm run sync) --------------------------------------
INTERVALS_ICU_ATHLETE_ID=
INTERVALS_ICU_API_KEY=
